import numpy as np
import matplotlib.pyplot as plt

# --- 1. 파라미터 설정 ---
c = 3e8
fc = 77e9
wavelength = c / fc
d_ant = wavelength / 2
Num_rx = 4

# [핵심 수정] N=4 FFT Bin의 중간에 위치하는 각도로 설정 (Off-grid Target Angle)
# N=4일 때 생성되는 Bin 각도 약: -90°, -30°, 0°, 30°
# -> 14.5°는 0°와 30° 딱 중간에 위치하여 N=4에서 최대 양자화 오차가 발생함
true_deg = 14.5
true_theta = np.radians(true_deg)

# Rx 안테나 수신 신호 생성 (1D Angle vector)
m = np.arange(Num_rx)
phase_ant = (2 * np.pi * m * d_ant * np.sin(true_theta)) / wavelength
rx_signal = np.exp(1j * phase_ant)

# 노이즈 추가 (실험 재현성을 위해 시드 고정)
np.random.seed(42)
noise = (np.random.randn(Num_rx) + 1j * np.random.randn(Num_rx)) * 0.05
rx_signal = rx_signal + noise

# --- 2. Case A: Zero-padding 미적용 (N_fft = 4) ---
N_no_pad = 4
fft_no_pad = np.fft.fft(rx_signal, N_no_pad)
mag_no_pad = np.abs(fft_no_pad)

# N=4일때 안테나 배열의 공간 주파수 눈금 생성
w_no_pad = np.fft.fftfreq(N_no_pad, d=1.0) * (2 * np.pi)
sin_no_pad = (wavelength * w_no_pad) / (2 * np.pi * d_ant)
angles_no_pad = np.degrees(np.arcsin(np.clip(sin_no_pad, -1.0, 1.0)))

# N=4 Peak 추정
idx_no_pad = np.argmax(mag_no_pad)
est_deg_no_pad = angles_no_pad[idx_no_pad]

# --- 3. Case B: Zero-padding 적용 (N_fft = 64) ---
N_pad = 64
fft_pad = np.fft.fft(rx_signal, N_pad)
mag_pad = np.abs(fft_pad)

# N=64일때 안테나 배열의 공간 주파수 눈금 생성
w_pad = np.fft.fftfreq(N_pad, d=1.0) * (2 * np.pi)
sin_pad = (wavelength * w_pad) / (2 * np.pi * d_ant)
angles_pad = np.degrees(np.arcsin(np.clip(sin_pad, -1.0, 1.0)))

# Plotting용 정렬
sort_idx = np.argsort(angles_pad)
angles_pad_sorted = angles_pad[sort_idx]
mag_pad_sorted = mag_pad[sort_idx]

# N=64 Peak 추정
idx_pad = np.argmax(mag_pad)
est_deg_pad = angles_pad[idx_pad]

# --- 4. 터미널 출력 ---
print("=" * 65)
print(f"실제 표적 각도 : {true_deg:.2f}°")
print("-" * 65)
print(f"[미적용 (N=4) ] 추정 각도 : {est_deg_no_pad:6.2f}° | 오차 : {abs(true_deg - est_deg_no_pad):5.2f}°")
print(f"[적용   (N=64)] 추정 각도 : {est_deg_pad:6.2f}° | 오차 : {abs(true_deg - est_deg_pad):5.2f}°")
print("=" * 65)

# --- 5. 시각화 ---
plt.figure(figsize=(10, 5))

# N=64 연속 스펙트럼 곡선
plt.plot(angles_pad_sorted, mag_pad_sorted, 'b-', label='With Zero-padding (N=64)', linewidth=2)

# N=4 이산 샘플 포인트
plt.stem(angles_no_pad, mag_no_pad, 'r', linefmt='r--', markerfmt='ro', basefmt=' ', label='Without Zero-padding (N=4)')

# 수직선 표시
plt.axvline(true_deg, color='k', linestyle=':', label=f'True Angle ({true_deg}°)', linewidth=2.5)
plt.axvline(est_deg_no_pad, color='r', linestyle='--', label=f'Est. N=4 ({est_deg_no_pad:.1f}°)')
plt.axvline(est_deg_pad, color='b', linestyle='--', label=f'Est. N=64 ({est_deg_pad:.1f}°)')

plt.title(f'Angle FFT Estimation Comparison (True Angle = {true_deg}°)', fontsize=13)
plt.xlabel('Angle (degrees)', fontsize=11)
plt.ylabel('FFT Magnitude', fontsize=11)
plt.xlim([-90, 90])
plt.grid(True, linestyle='--', alpha=0.6)
plt.legend(loc='upper right')
plt.tight_layout()
plt.show()
